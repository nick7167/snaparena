# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but the example carries no secrets and must be committed, or nobody can
# work out what the app needs to run.
!.env.local.example

# Ingested track data: large, regenerable via `npm run ingest`, and derived from
# a third-party catalogue rather than authored here.
/data/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# Vendored agent skills, installed by `uipro init` rather than written here.
# ~3MB of CSV databases and Python, six of the seven unrelated to this project.
# They work the same installed locally; keeping them out of the repo keeps a clone small.
# Everything else under .claude/skills/ IS ours and stays tracked.
/.claude/skills/ui-ux-pro-max/
/.claude/skills/banner-design/
/.claude/skills/brand/
/.claude/skills/design/
/.claude/skills/design-system/
/.claude/skills/slides/
/.claude/skills/ui-styling/

# playwright
/playwright/.clerk/
/e2e/screenshots/
/e2e/.answers.json
/test-results/
/playwright-report/
/blob-report/
