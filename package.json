{
  "name": "codespaces-blank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n stdb,next -c magenta,cyan -k --handle-input \"npm:dev:stdb\" \"npm:dev:next\"",
    "dev:stdb": "spacetime dev --client-lang typescript --module-bindings-path ./src/module_bindings",
    "dev:next": "next dev",
    "stdb:build": "spacetime build",
    "stdb:publish": "spacetime publish snaparena-740t8 --server maincloud --yes",
    "stdb:generate": "spacetime generate --lang typescript --out-dir ./src/module_bindings --module-path ./spacetimedb --yes",
    "stdb:logs": "spacetime logs snaparena-740t8 --server maincloud -f",
    "stdb:sql": "spacetime sql snaparena-740t8 --server maincloud",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit && npm run typecheck:stdb",
    "typecheck:stdb": "tsc --noEmit -p spacetimedb/tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/ingest.ts",
    "ingest:smoke": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/ingest.ts --artists 2",
    "emblem-ref": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/emblem-ref.ts",
    "emblem-slice": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/slice-emblems.ts",
    "emblem-small": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/emblem-small.ts",
    "import-tracks": "node --experimental-strip-types --import ./scripts/loader.mjs --env-file-if-exists=.env.local scripts/import-tracks.ts",
    "seed-bots": "node --experimental-strip-types --import ./scripts/loader.mjs --env-file-if-exists=.env.local scripts/seed-bots.ts",
    "posthog-insights": "node --experimental-strip-types --import ./scripts/loader.mjs --env-file=.env.local scripts/posthog-insights.ts",
    "dev-bots": "node --experimental-strip-types --import ./scripts/loader.mjs --env-file-if-exists=.env.local scripts/dev-rank-bots.ts",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "npm run build && playwright test --ui",
    "emblem-preview": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/emblem-preview.ts",
    "build-icon": "node --experimental-strip-types --import ./scripts/loader.mjs scripts/build-icon.ts",
    "stdb:auth": "spacetime call snaparena-740t8 --server maincloud set_auth_issuer"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "posthog-js": "^1.413.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "spacetimedb": "2.8.*"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.16",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
