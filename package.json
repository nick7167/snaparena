{
  "name": "codespaces-blank",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n convex,next -c magenta,cyan -k --handle-input \"npm:dev:convex\" \"npm:dev:next\"",
    "dev:convex": "convex dev",
    "dev:next": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ingest": "node scripts/ingest.ts",
    "ingest:smoke": "node scripts/ingest.ts --artists 2",
    "emblem-ref": "node scripts/emblem-ref.ts",
    "emblem-slice": "node scripts/slice-emblems.ts",
    "emblem-small": "node scripts/emblem-small.ts",
    "import-tracks": "node --env-file=.env.local scripts/import-tracks.ts",
    "seed-bots": "node --env-file=.env.local scripts/seed-bots.ts",
    "dev-bots": "node --env-file=.env.local scripts/dev-rank-bots.ts",
    "e2e": "npm run build && playwright test",
    "e2e:ui": "npm run build && playwright test --ui",
    "emblem-preview": "node scripts/emblem-preview.ts",
    "build-icon": "node scripts/build-icon.ts"
  },
  "dependencies": {
    "@clerk/nextjs": "^7.6.4",
    "convex": "^1.43.0",
    "motion": "^12.43.0",
    "next": "16.2.12",
    "posthog-js": "^1.413.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@clerk/testing": "^2.2.16",
    "@edge-runtime/vm": "^5.0.0",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.4",
    "convex-test": "^0.0.55",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "sharp": "^0.34.5",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
