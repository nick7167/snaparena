{
  "compilerOptions": {
    /*
     * ES2020 for BigInt. Every `u64` column arrives in the client as a bigint — ids,
     * match ids, user ids — so the app cannot express an id literal without it. The
     * old ES2017 target predates the SpacetimeDB port, when ids were opaque strings.
     */
    "target": "ES2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    // scripts/ are executed directly by Node's native TypeScript stripping
    // (`node scripts/ingest.ts`), which requires explicit .ts import specifiers.
    "allowImportingTsExtensions": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  /*
   * `spacetimedb/` is typechecked by its own tsconfig, not this one.
   *
   * The module targets ESNext because SpacetimeDB requires it, and its code uses
   * BigInt literals throughout — every `u64` column is a bigint. The app targets
   * ES2017, so pulling the module in here reported 25 "BigInt literals are not
   * available" errors against code that is perfectly valid under the config it
   * actually builds with. That noise made `npm run typecheck` useless as a gate,
   * which is worse than not running it. `npm run typecheck` now runs both.
   */
  "exclude": ["node_modules", "spacetimedb"]
}
