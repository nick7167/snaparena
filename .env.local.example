# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local — only this example.
#
#   cp .env.local.example .env.local
#
# Some values are NOT read from here at runtime. A SpacetimeDB module has no
# environment to read, so the OIDC issuer allow-list lives in the database and is
# registered once with `npm run stdb:auth` — see the Clerk section below.
# ---------------------------------------------------------------------------


# --- SpacetimeDB -----------------------------------------------------------
# Where the browser opens its WebSocket, and which database to open it against.
# Both are public by design — the module authorises every call itself, so a URL
# is not a credential.
#
# Local development, with `spacetime start` running:
#
#   NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3000
#
# Maincloud:
#
#   NEXT_PUBLIC_SPACETIMEDB_URI=https://maincloud.spacetimedb.com

NEXT_PUBLIC_SPACETIMEDB_URI=http://127.0.0.1:3000
NEXT_PUBLIC_SPACETIMEDB_DB=snaparena-740t8


# --- Clerk (browser) -------------------------------------------------------
# From dashboard.clerk.com -> your app -> API keys.
# Enable ONLY Google and Discord as providers: one-click OAuth with no password
# and no email verification was a deliberate product decision, because an account
# wall sits in front of the game's first-run experience.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Clerk <-> SpacetimeDB bridge ------------------------------------------
# Create a JWT template named exactly "spacetimedb" in the Clerk dashboard, then
# copy its Issuer URL. The module derives each player's Identity from the token's
# `iss` + `sub`, so `sub` is what `clerkId` used to be.
#
# THIS IS NOT READ FROM THIS FILE AT RUNTIME. The module has no environment to
# read, so the issuer lives in a table and is registered once per database:
#
#   npm run stdb:auth -- '"https://your-app.clerk.accounts.dev"' '"<audience>"'
#
# Until that is done, `ensureUser` refuses every sign-in with "Unauthorized
# issuer". That is the intended failure mode, and the same call the Convex setup
# made — auth silently not working is far worse than a loud refusal. An empty
# allow-list deliberately does not mean "accept anything", which would accept a
# token from any OIDC provider on the internet.
#
# Pass "" as the audience to accept any `aud` from that issuer. Prefer a real
# value: without it, a token another application legitimately issued to the same
# user could be replayed here.

CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev


# --- Content import --------------------------------------------------------
# There is no shared secret any more. The importer and the seed scripts
# authenticate as the MODULE OWNER — the identity that ran `spacetime publish`,
# captured in the `module_owner` table by the `init` reducer.
#
# So the only requirement is being logged in as whoever published the database:
#
#   spacetime login
#   npm run import-tracks
#
# That also replaces `roles:grantBySecret`: the first admin is granted by the
# owner with `set_role`, because a SpacetimeDB database knows who owns it and a
# Convex deployment did not.


# --- Product analytics -----------------------------------------------------
# PostHog. WITHOUT THIS KEY ANALYTICS ARE ENTIRELY OFF — `track()` becomes a no-op,
# nothing is loaded, and no request leaves the browser. That is the intended state
# for local development, CI and the e2e suite, so the events they generate never
# reach the production project.
#
# Set it in Vercel (or wherever the app is deployed) to turn measurement on. The
# project key is public by design; it is write-only and safe to ship to a browser.
#
#   NEXT_PUBLIC_POSTHOG_KEY=phc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
#
# The host defaults to https://eu.i.posthog.com. Override it ONLY deliberately —
# the default is EU because the wrong default silently ships EU player data to a
# US region, which is a compliance decision rather than a technical one.
#
#   NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
#
# This project's PostHog org is on EU Cloud, so the default is already correct and
# the override must stay unset. Worth knowing why that matters: posting to the wrong
# region returns HTTP 200 and drops the event, so the failure looks like no traffic
# rather than like an error.

# NEXT_PUBLIC_POSTHOG_KEY=
# NEXT_PUBLIC_POSTHOG_HOST=


# --- Not required ----------------------------------------------------------
# No key is needed for the iTunes Search API: it is unauthenticated. It is rate
# limited to roughly 20 requests/minute, which is why ingest is an offline script
# (scripts/ingest.ts) writing data/tracks.json rather than anything that runs at
# request time.
