# ---------------------------------------------------------------------------
# Copy to .env.local and fill in. Never commit .env.local — only this example.
#
#   cp .env.local.example .env.local
#
# Some values live on the Convex deployment rather than in this file; those are
# marked "convex env set" and are NOT read from here at runtime.
# ---------------------------------------------------------------------------


# --- Convex ----------------------------------------------------------------
# Written automatically by `npx convex dev`. You should not need to edit these
# by hand; re-running `npx convex dev` restores them.

CONVEX_DEPLOYMENT=dev:your-deployment-name
NEXT_PUBLIC_CONVEX_URL=https://your-deployment-name.convex.cloud
NEXT_PUBLIC_CONVEX_SITE_URL=https://your-deployment-name.convex.site


# --- Clerk (browser) -------------------------------------------------------
# From dashboard.clerk.com -> your app -> API keys.
# Enable ONLY Google and Discord as providers: one-click OAuth with no password
# and no email verification was a deliberate product decision, because an account
# wall sits in front of the game's first-run experience.

NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxx


# --- Clerk <-> Convex bridge ----------------------------------------------
# Convex verifies the Clerk JWT, so it needs the issuer domain. Create a JWT
# template named exactly "convex" in the Clerk dashboard, then copy its Issuer URL.
#
# This one must ALSO be set on the deployment, because the verification happens
# inside Convex, not in Next.js:
#
#   npx convex env set CLERK_JWT_ISSUER_DOMAIN https://your-app.clerk.accounts.dev
#
# convex/auth.config.ts reads it from the deployment environment.

CLERK_JWT_ISSUER_DOMAIN=https://your-app.clerk.accounts.dev


# --- Content import --------------------------------------------------------
# Shared secret guarding convex/admin.ts. The track importer runs from a terminal
# with no Clerk session, so it authenticates with this instead of a user token.
#
# Generate one, then set it in BOTH places (they must match):
#
#   export ADMIN_IMPORT_SECRET="$(openssl rand -hex 24)"
#   npx convex env set ADMIN_IMPORT_SECRET "$ADMIN_IMPORT_SECRET"
#
# `npm run import-tracks` reads it from this file; convex/admin.ts reads it from
# the deployment. An import fails loudly if they disagree.

ADMIN_IMPORT_SECRET=generate_with_openssl_rand_hex_24


# --- Not required ----------------------------------------------------------
# No key is needed for the iTunes Search API: it is unauthenticated. It is rate
# limited to roughly 20 requests/minute, which is why ingest is an offline script
# (scripts/ingest.ts) writing data/tracks.json rather than anything that runs at
# request time.
