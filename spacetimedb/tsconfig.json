/*
 * Module tsconfig. Generated by `spacetime init --lang typescript`; the options
 * under "required by SpacetimeDB" are load-bearing and must not be changed.
 *
 * `include` reaches up into ../src/engine because the module imports the game
 * engine directly rather than reimplementing it — see spacetimedb/src/schema.ts.
 */
{
  "compilerOptions": {
    "strict": true,
    "skipLibCheck": true,
    "moduleResolution": "bundler",

    /* The following options are required by SpacetimeDB
     * and should not be modified
     */
    "target": "ESNext",
    "lib": ["ES2021", "dom"],
    "module": "ESNext",
    "isolatedModules": true,
    "noEmit": true
  },
  /*
   * The engine's colocated vitest files are excluded: they are compiled by the
   * app's own toolchain, and pulling them in here would make the module build
   * depend on vitest's types for no benefit. The engine source itself is
   * included so the module typechecks against the same code it runs.
   */
  "include": ["./src/**/*", "../src/engine/**/*"],
  "exclude": ["../src/engine/**/*.test.ts", "node_modules"]
}
